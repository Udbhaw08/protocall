# Copy to .env.local for local frontend development.
# Do not put production secrets in Vite env vars because VITE_* values are exposed to the browser.

# Frontend -> backend API base URL
VITE_API_URL=http://localhost:3001

# Local prototype only:
# The live audio interview currently requires a browser-visible key.
# Do not use this for public production launch.
VITE_GEMINI_API_KEY=local_prototype_only_replace_me

# Keep true while this app runs as the standalone Protocall product.
VITE_STANDALONE_PROTOCOL=true

# Stripe publishable key is safe to expose in the browser.
# Use your pk_test key locally and pk_live key only in production.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Supabase frontend values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PostHog browser analytics
VITE_POSTHOG_KEY=phc_replace_me
VITE_POSTHOG_HOST=https://us.i.posthog.com
