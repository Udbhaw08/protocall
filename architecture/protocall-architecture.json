      "dot": "cyan",
      "title": "Client Tier (Vercel)",
      "items": [
        "React 18 SPA built with Vite, Tailwind CSS, & Framer Motion",
        "Live MediaStream audio capture (16kHz PCM input / 24kHz PCM output)",
        "Webcam visual feedback (1 frame/sec) observing candidate cues & posture",
        "Multi-dimensional radar scoring & progress analytics rendered via Recharts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend Services (Render)",
      "items": [
        "Express API proxy with strict CORS and IP rate-limiting (20 req/hr)",
        "Secure server-side API key isolation preventing browser credential leakage",
        "Stripe checkout session orchestration & raw body cryptographic HMAC verification",
        "Session history & user state persistence targeting Supabase PostgreSQL"
      ]
    },
    {
      "dot": "violet",
      "title": "Dual AI Engine (Google Gemini)",
      "items": [
        "Gemini 2.5 Flash Native Audio for real-time bidirectional conversational mock interviews",
        "Gemini 2.5 Flash Text API for structured JSON scoring across 4 evaluation pillars",
        "Rubrics: Clarity (1-100), Confidence (1-100), Communication (1-100), Technical Knowledge",
        "Automated extraction of candidate strengths, weaknesses, and curated study recommendations"
      ]
    },
    {
      "dot": "amber",
      "title": "Security & Production Readiness",
      "items": [
        "Zero secret leakage: Gemini API keys and Stripe secrets remain strictly server-side",
        "Ephemeral audio context isolation prevents cross-session memory leakage",
        "Automated webhook reconciliation ensures resilient subscription sync without race conditions"
      ]
    }
