# Copy to .env and fill in real values — never commit .env

# Your Gemini API key (server-side only, never sent to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional: override the analysis model
ANALYSIS_MODEL=gemini-2.5-flash

# Port (Railway/Render set this automatically)
PORT=3001

# Stripe server-side keys. Never expose these in frontend VITE_* env vars.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLUS_PRODUCT_ID=prod_replace_me
STRIPE_PRO_PRODUCT_ID=prod_replace_me
STRIPE_PLUS_PRICE_ID=price_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me

# Public app URL used by Stripe checkout redirects
APP_URL=http://localhost:5173

# Email provider for waitlist, onboarding, and interview follow-ups
RESEND_API_KEY=re_replace_me
FROM_EMAIL=Protocall <onboarding@resend.dev>

# Supabase backend/admin values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
